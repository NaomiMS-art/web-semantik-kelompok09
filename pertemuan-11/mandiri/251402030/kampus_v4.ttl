@prefix ex:   <http://contoh.id/kampus/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Dosen      rdfs:subClassOf foaf:Person .
ex:DosenTetap rdfs:subClassOf ex:Dosen .
ex:Mahasiswa  rdfs:subClassOf foaf:Person .

ex:budi a ex:DosenTetap , ex:Dosen , foaf:Person ; foaf:name "Budi Santoso" .
ex:sari a ex:Dosen , foaf:Person ; foaf:name "Sari Lubis" .
ex:andi a ex:Mahasiswa , foaf:Person ; foaf:name "Andi Siregar" .
ex:rina a ex:DosenTetap , ex:Dosen , foaf:Person .
