    <maritim:maxPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000000</maritim:maxPrice>
  </maritim:KategoriRangeHarga>
  <maritim:KategoriRangeHarga rdf:about="http://wisatamaritim.id/resource/Range_Above1M">
    <rdfs:label xml:lang="id">Di atas Rp1.000.000</rdfs:label>
