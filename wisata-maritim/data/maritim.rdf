  </maritim:KategoriRangeHarga>
  <maritim:KategoriRangeHarga rdf:about="http://wisatamaritim.id/resource/Range_500k_1M">
    <rdfs:label xml:lang="id">Rp500.000 – Rp1.000.000</rdfs:label>
