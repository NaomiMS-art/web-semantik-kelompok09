    <rdfs:label xml:lang="id">Rp100.000 – Rp250.000</rdfs:label>
    <maritim:minPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100000</maritim:minPrice>
    <maritim:maxPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250000</maritim:maxPrice>
  </maritim:KategoriRangeHarga>
  <maritim:KategoriRangeHarga rdf:about="http://wisatamaritim.id/resource/Range_250k_500k">
    <rdfs:label xml:lang="id">Rp250.000 – Rp500.000</rdfs:label>
