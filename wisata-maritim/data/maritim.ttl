@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix data: <http://wisatamaritim.id/resource/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix maritim: <http://wisatamaritim.id/ontology#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://wisatamaritim.id/ontology#estimasiHarga
maritim:estimasiHarga rdf:type owl:AnnotationProperty .


###  http://wisatamaritim.id/ontology#jarakKm
maritim:jarakKm rdf:type owl:AnnotationProperty .


###  http://wisatamaritim.id/ontology#kategoriHargaAktivitas
maritim:kategoriHargaAktivitas rdf:type owl:AnnotationProperty .


###  http://wisatamaritim.id/ontology#kategoriKuliner
maritim:kategoriKuliner rdf:type owl:AnnotationProperty .


###  http://wisatamaritim.id/ontology#kode
maritim:kode rdf:type owl:AnnotationProperty .


###  http://wisatamaritim.id/ontology#lokasiLengkap
maritim:lokasiLengkap rdf:type owl:AnnotationProperty .


###  http://wisatamaritim.id/ontology#maxPrice
maritim:maxPrice rdf:type owl:AnnotationProperty .


###  http://wisatamaritim.id/ontology#menuAndalan
maritim:menuAndalan rdf:type owl:AnnotationProperty .


###  http://wisatamaritim.id/ontology#minPrice
maritim:minPrice rdf:type owl:AnnotationProperty .


###  http://wisatamaritim.id/ontology#rating
maritim:rating rdf:type owl:AnnotationProperty .


###  https://schema.org/image
schema:image rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://wisatamaritim.id/ontology#alatTerkait
maritim:alatTerkait rdf:type owl:ObjectProperty ;
                    rdfs:domain maritim:PenawaranAlat ;
                    rdfs:range maritim:Peralatan .


###  http://wisatamaritim.id/ontology#beradaDiProvinsi
maritim:beradaDiProvinsi rdf:type owl:ObjectProperty ;
                         rdfs:domain maritim:DestinasiWisata ;
                         rdfs:range maritim:Provinsi .


###  http://wisatamaritim.id/ontology#beradaDiWilayah
maritim:beradaDiWilayah rdf:type owl:ObjectProperty ;
                        rdfs:domain maritim:DestinasiWisata ;
                        rdfs:range maritim:Wilayah .


###  http://wisatamaritim.id/ontology#cocokUntukTingkat
maritim:cocokUntukTingkat rdf:type owl:ObjectProperty ;
                          rdfs:domain maritim:DestinasiWisata ;
                          rdfs:range maritim:TingkatKeahlian .


###  http://wisatamaritim.id/ontology#kategoriHargaTiket
maritim:kategoriHargaTiket rdf:type owl:ObjectProperty ;
                           rdfs:domain maritim:DestinasiWisata ;
                           rdfs:range maritim:KategoriRangeHarga .


###  http://wisatamaritim.id/ontology#kategoriHargaTotal
maritim:kategoriHargaTotal rdf:type owl:ObjectProperty ;
                           rdfs:domain maritim:DestinasiWisata ;
                           rdfs:range maritim:KategoriRangeHarga .


###  http://wisatamaritim.id/ontology#memilikiAktivitas
maritim:memilikiAktivitas rdf:type owl:ObjectProperty ;
                          rdfs:domain maritim:DestinasiWisata ;
                          rdfs:range maritim:Aktivitas .


###  http://wisatamaritim.id/ontology#memilikiFasilitas
maritim:memilikiFasilitas rdf:type owl:ObjectProperty ;
                          rdfs:domain maritim:DestinasiWisata ;
                          rdfs:range maritim:Fasilitas .


###  http://wisatamaritim.id/ontology#memilikiJenisWisata
maritim:memilikiJenisWisata rdf:type owl:ObjectProperty ;
                            rdfs:domain maritim:DestinasiWisata ;
                            rdfs:range maritim:JenisWisata .


###  http://wisatamaritim.id/ontology#memilikiKulinerSekitar
maritim:memilikiKulinerSekitar rdf:type owl:ObjectProperty ;
                               rdfs:domain maritim:DestinasiWisata ;
                               rdfs:range maritim:KulinerSekitar .


###  http://wisatamaritim.id/ontology#memilikiPenawaranAlat
maritim:memilikiPenawaranAlat rdf:type owl:ObjectProperty ;
                              rdfs:domain maritim:DestinasiWisata ;
                              rdfs:range maritim:PenawaranAlat .


###  http://wisatamaritim.id/ontology#tingkatAlat
maritim:tingkatAlat rdf:type owl:ObjectProperty ;
                    rdfs:domain maritim:PenawaranAlat ;
                    rdfs:range maritim:TingkatKeahlian .


#################################################################
#    Data properties
#################################################################

###  http://wisatamaritim.id/ontology#estimasiTotalBiaya
maritim:estimasiTotalBiaya rdf:type owl:DatatypeProperty ;
                           rdfs:domain maritim:DestinasiWisata ;
                           rdfs:range xsd:integer .


###  http://wisatamaritim.id/ontology#hargaAktivitasMulai
maritim:hargaAktivitasMulai rdf:type owl:DatatypeProperty ;
                            rdfs:domain maritim:DestinasiWisata ;
                            rdfs:range xsd:integer .


###  http://wisatamaritim.id/ontology#hargaSewa
maritim:hargaSewa rdf:type owl:DatatypeProperty ;
                  rdfs:domain maritim:PenawaranAlat ;
                  rdfs:range xsd:integer .


###  http://wisatamaritim.id/ontology#hargaTiketMasuk
maritim:hargaTiketMasuk rdf:type owl:DatatypeProperty ;
                        rdfs:domain maritim:DestinasiWisata ;
                        rdfs:range xsd:integer .


###  http://wisatamaritim.id/ontology#latitude
maritim:latitude rdf:type owl:DatatypeProperty ;
                 rdfs:domain maritim:DestinasiWisata ;
                 rdfs:range xsd:decimal .


###  http://wisatamaritim.id/ontology#longitude
maritim:longitude rdf:type owl:DatatypeProperty ;
                  rdfs:domain maritim:DestinasiWisata ;
                  rdfs:range xsd:decimal .


###  http://wisatamaritim.id/ontology#namaDestinasi
maritim:namaDestinasi rdf:type owl:DatatypeProperty ;
                      rdfs:domain maritim:DestinasiWisata ;
                      rdfs:range xsd:string .


###  http://wisatamaritim.id/ontology#statusSewa
maritim:statusSewa rdf:type owl:DatatypeProperty ;
                   rdfs:domain maritim:PenawaranAlat ;
                   rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://wisatamaritim.id/ontology#Aktivitas
maritim:Aktivitas rdf:type owl:Class ;
                  rdfs:comment "Aktivitas rekreasi atau olahraga laut (cth: Snorkeling, Diving, Surfing)."@id ;
                  rdfs:label "Aktivitas Bahari"@id .


###  http://wisatamaritim.id/ontology#DestinasiWisata
maritim:DestinasiWisata rdf:type owl:Class ;
                        rdfs:subClassOf schema:TouristAttraction ;
                        rdfs:comment "Entitas destinasi wisata pesisir, laut, dan pulau di Indonesia."@id ;
                        rdfs:label "Destinasi Wisata Maritim"@id ,
                                   "Maritime Tourism Destination"@en .


###  http://wisatamaritim.id/ontology#Fasilitas
maritim:Fasilitas rdf:type owl:Class ;
                  rdfs:comment "Sarana pendukung di lokasi (cth: Dive Center, Homestay, Dermaga)."@id ;
                  rdfs:label "Fasilitas Wisata"@id .


###  http://wisatamaritim.id/ontology#JenisWisata
maritim:JenisWisata rdf:type owl:Class ;
                    rdfs:comment "Klasifikasi kategori wisata bahari (cth: Wisata Bawah Laut, Pantai, Resor)."@id ;
                    rdfs:label "Jenis Wisata"@id .


###  http://wisatamaritim.id/ontology#KategoriRangeHarga
maritim:KategoriRangeHarga rdf:type owl:Class ;
                           rdfs:comment "Klasifikasi rentang budget Google-style (<100k, 100k-250k, 250k-500k, 500k-1M, >1M)."@id ;
                           rdfs:label "Kategori Range Harga"@id .


###  http://wisatamaritim.id/ontology#KulinerSekitar
maritim:KulinerSekitar rdf:type owl:Class ;
                       rdfs:label "Kuliner Sekitar Destinasi"@id .


###  http://wisatamaritim.id/ontology#PenawaranAlat
maritim:PenawaranAlat rdf:type owl:Class ;
                      rdfs:comment "Ketersediaan dan tarif persewaan alat di lokasi destinasi."@id ;
                      rdfs:label "Penawaran / Persewaan Alat"@id .


###  http://wisatamaritim.id/ontology#Peralatan
maritim:Peralatan rdf:type owl:Class ;
                  rdfs:comment "Peralatan rekreasi laut (cth: Masker, Snorkel, Fins, BCD, Papan Selancar)."@id ;
                  rdfs:label "Peralatan Bahari"@id .


###  http://wisatamaritim.id/ontology#Provinsi
maritim:Provinsi rdf:type owl:Class ;
                 rdfs:label "Provinsi"@id .


###  http://wisatamaritim.id/ontology#TingkatKeahlian
maritim:TingkatKeahlian rdf:type owl:Class ;
                        rdfs:comment "Level kompetensi fisik atau keahlian bahari (Pemula, Menengah, Mahir)."@id ;
                        rdfs:label "Tingkat Keahlian"@id .


###  http://wisatamaritim.id/ontology#Wilayah
maritim:Wilayah rdf:type owl:Class ;
                rdfs:label "Wilayah Indonesia"@id .


###  https://schema.org/TouristAttraction
schema:TouristAttraction rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://wisatamaritim.id/resource/Range_100k_250k
data:Range_100k_250k rdf:type owl:NamedIndividual ,
                              maritim:KategoriRangeHarga ;
                     maritim:maxPrice 250000 ;
                     maritim:minPrice 100000 ;
                     rdfs:label "Rp100.000 – Rp250.000"@id .


###  http://wisatamaritim.id/resource/Range_250k_500k
data:Range_250k_500k rdf:type owl:NamedIndividual ,
                              maritim:KategoriRangeHarga ;
                     maritim:maxPrice 500000 ;
                     maritim:minPrice 250001 ;
                     rdfs:label "Rp250.000 – Rp500.000"@id .


###  http://wisatamaritim.id/resource/Range_500k_1M
data:Range_500k_1M rdf:type owl:NamedIndividual ,
                            maritim:KategoriRangeHarga ;
                   maritim:maxPrice 1000000 ;
                   maritim:minPrice 500001 ;
                   rdfs:label "Rp500.000 – Rp1.000.000"@id .


###  http://wisatamaritim.id/resource/Range_Above1M
data:Range_Above1M rdf:type owl:NamedIndividual ,
                            maritim:KategoriRangeHarga ;
                   maritim:maxPrice 999999999 ;
                   maritim:minPrice 1000001 ;
                   rdfs:label "Di atas Rp1.000.000"@id .


###  http://wisatamaritim.id/resource/Range_Under100k
data:Range_Under100k rdf:type owl:NamedIndividual ,
                              maritim:KategoriRangeHarga ;
                     maritim:maxPrice 99999 ;
                     maritim:minPrice 0 ;
                     rdfs:label "Di bawah Rp100.000"@id .


###  http://wisatamaritim.id/resource/Tingkat_Mahir
data:Tingkat_Mahir rdf:type owl:NamedIndividual ,
                            maritim:TingkatKeahlian ;
                   rdfs:comment "Untuk penyelam berpengalaman (Advanced/Rescue) atau peselancar ombak besar."@id ;
                   rdfs:label "Advanced"@en ,
                              "Mahir"@id .


###  http://wisatamaritim.id/resource/Tingkat_Menengah
data:Tingkat_Menengah rdf:type owl:NamedIndividual ,
                               maritim:TingkatKeahlian ;
                      rdfs:comment "Membutuhkan keahlian dasar, ketahanan fisik, atau sertifikasi Open Water."@id ;
                      rdfs:label "Intermediate"@en ,
                                 "Menengah"@id .


###  http://wisatamaritim.id/resource/Tingkat_Pemula
data:Tingkat_Pemula rdf:type owl:NamedIndividual ,
                             maritim:TingkatKeahlian ;
                    rdfs:comment "Cocok untuk wisatawan tanpa sertifikasi, perairan tenang atau berpanduan."@id ;
                    rdfs:label "Beginner"@en ,
                               "Pemula"@id .


###  http://wisatamaritim.id/resource/Tingkat_SemuaLevel
data:Tingkat_SemuaLevel rdf:type owl:NamedIndividual ,
                                 maritim:TingkatKeahlian ;
                        rdfs:label "All Levels"@en ,
                                   "Semua level"@id .


