###  http://wisatamaritim.id/resource/destinasi_BNT-04
data:destinasi_BNT-04 rdf:type owl:NamedIndividual ,
                               maritim:DestinasiWisata ;
                      maritim:beradaDiProvinsi data:provinsi_Bali ;
                      maritim:beradaDiWilayah data:wilayah_Bali___Nusa_Tenggara ;
                      maritim:cocokUntukTingkat data:Tingkat_Pemula ;
