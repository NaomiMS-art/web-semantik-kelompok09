                                                    data:offer_BNT-02_3 ,
                                                    data:offer_BNT-02_4 ,
                                                    data:offer_BNT-02_5 ,
                                                    data:offer_BNT-02_6 ,
                                                    data:offer_BNT-02_7 ,
                                                    data:offer_BNT-02_8 ,
                                                    data:offer_BNT-02_9 ;
