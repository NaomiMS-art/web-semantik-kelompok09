###  http://wisatamaritim.id/resource/destinasi_BNT-01
data:destinasi_BNT-01 rdf:type owl:NamedIndividual ,
                               maritim:DestinasiWisata ;
                      maritim:beradaDiProvinsi data:provinsi_Bali ;
                      maritim:beradaDiWilayah data:wilayah_Bali___Nusa_Tenggara ;
                      maritim:cocokUntukTingkat data:Tingkat_Pemula ;
                      maritim:kategoriHargaTiket data:Range_Under100k ;
                      maritim:kategoriHargaTotal data:Range_Under100k ;
                      maritim:memilikiAktivitas data:aktivitas_Surfing ,
                                                data:aktivitas_Wahana_Air ;
                      maritim:memilikiFasilitas data:fasilitas_Toilet ,
                                                data:fasilitas_lifeguard ,
                                                data:fasilitas_parkir ,
                                                data:fasilitas_sewa_papan ;
                      maritim:memilikiKulinerSekitar data:kuliner_BNT-01_0 ,
                                                     data:kuliner_BNT-01_1 ,
                                                     data:kuliner_BNT-01_2 ;
                      maritim:memilikiPenawaranAlat data:offer_BNT-01_0 ,
                                                    data:offer_BNT-01_1 ,
                                                    data:offer_BNT-01_2 ;
                      maritim:estimasiTotalBiaya 50000 ;
                      maritim:hargaAktivitasMulai 50000 ;
                      maritim:hargaTiketMasuk 0 ;
                      maritim:latitude -8.7183 ;
                      maritim:longitude 115.169 ;
                      maritim:namaDestinasi "Pantai Kuta" ;
                      maritim:kategoriHargaAktivitas data:Range_Under100k ;
                      maritim:kode "BNT-01" ;
                      maritim:lokasiLengkap "Badung, Bali" ;
                      rdfs:label "Pantai Kuta"@id ;
                      schema:image "https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bf/Pantai_Kuta_sejuta_cinta.jpg/960px-Pantai_Kuta_sejuta_cinta.jpg?utm_source=id.wikipedia.org&utm_campaign=api&utm_content=thumbnail" .


